{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aircraft-noise.local/schemas/aircraft_request.schema.json",
  "type": "object",
  "properties": {
    "project": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string"
        },
        "assessment_id": {
          "type": "string"
        },
        "client": {
          "type": [
            "string",
            "null"
          ]
        },
        "site_address": {
          "type": [
            "string",
            "null"
          ]
        },
        "proposal": {
          "type": [
            "string",
            "null"
          ]
        },
        "building_use": {
          "type": [
            "string",
            "null"
          ]
        },
        "airport_id": {
          "const": "YSSY"
        },
        "forecast_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "assessment_purpose": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "project_id",
        "assessment_id",
        "client",
        "site_address",
        "proposal",
        "building_use",
        "airport_id",
        "forecast_year",
        "assessment_purpose"
      ],
      "additionalProperties": false
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "data_mode": {
      "enum": [
        "synthetic",
        "project"
      ]
    },
    "crs": {
      "const": "EPSG:4326"
    },
    "receptors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "receptor_id": {
            "type": "string",
            "minLength": 1
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "confirmed": {
            "type": "boolean"
          },
          "coordinate_source": {
            "type": "string"
          },
          "elevation_m": {
            "type": [
              "number",
              "null"
            ]
          },
          "vertical_datum": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "receptor_id",
          "latitude",
          "longitude",
          "confirmed",
          "coordinate_source",
          "elevation_m",
          "vertical_datum"
        ],
        "additionalProperties": false
      }
    },
    "uncertainty_m": {
      "type": "number",
      "minimum": 0,
      "maximum": 10000
    },
    "airport_elevation_m": {
      "type": [
        "number",
        "null"
      ]
    },
    "airport_vertical_datum": {
      "type": [
        "string",
        "null"
      ]
    },
    "operation_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "operation_case_id": {
            "type": "string"
          },
          "receptor_id": {
            "type": "string"
          },
          "aircraft": {
            "type": "string"
          },
          "aircraft_kind": {
            "enum": [
              "fixed_wing",
              "helicopter",
              "other"
            ]
          },
          "runway_id": {
            "type": "string"
          },
          "direction": {
            "type": "string"
          },
          "operation": {
            "enum": [
              "arrival",
              "departure"
            ]
          },
          "load": {
            "type": "string"
          },
          "table_id": {
            "type": "string"
          },
          "path": {
            "enum": [
              "straight",
              "curved"
            ]
          },
          "mapping_evidence": {
            "type": "string"
          },
          "relevance_evidence": {
            "type": "string"
          },
          "lookup_policy": {
            "enum": [
              "exact",
              "approved_bilinear"
            ]
          },
          "terrain_category": {
            "type": "string"
          },
          "excluded": {
            "type": "boolean"
          },
          "exclusion_reason": {
            "type": "string"
          },
          "spectrum_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "operation_case_id",
          "receptor_id",
          "aircraft",
          "runway_id",
          "direction",
          "operation",
          "load",
          "table_id"
        ],
        "additionalProperties": false
      }
    },
    "noise_tables": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "distance_axis_m": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "ds_axis_m": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "values_db": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": [
                  "number",
                  "null",
                  "string"
                ]
              }
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verification_status": {
            "enum": [
              "verified",
              "unverified",
              "synthetic"
            ]
          },
          "interpolation_approval": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "distance_axis_m",
          "ds_axis_m",
          "values_db",
          "source_refs",
          "verification_status"
        ],
        "additionalProperties": false
      }
    },
    "terrain_tables": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          },
          "verification_status": {
            "enum": [
              "verified",
              "unverified",
              "synthetic"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "rows",
          "verification_status",
          "source_refs"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "https://aircraft-noise.local/schemas/common.schema.json#/$defs/SourceRecord"
      }
    },
    "criterion_catalogue": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion_id": {
            "type": "string"
          },
          "building_type": {
            "type": "string"
          },
          "activity": {
            "type": "string"
          },
          "level": {
            "$ref": "https://aircraft-noise.local/schemas/common.schema.json#/$defs/Quantity"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "applicability_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "criterion_id",
          "building_type",
          "activity",
          "level",
          "source_refs",
          "applicability_notes"
        ],
        "additionalProperties": false
      }
    },
    "spectra": {
      "type": "array",
      "items": {
        "$ref": "https://aircraft-noise.local/schemas/common.schema.json#/$defs/Spectrum"
      }
    },
    "footprint": {
      "type": [
        "object",
        "null"
      ]
    },
    "anef_override": {
      "type": "object",
      "properties": {
        "receptor_id": {
          "type": "string"
        },
        "label": {
          "type": [
            "number",
            "null"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 5
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "receptor_id",
        "label",
        "reason",
        "reviewer",
        "timestamp"
      ],
      "additionalProperties": false
    },
    "forecast": {
      "type": "object",
      "required": [
        "enabled",
        "lookup_policy",
        "height_mode"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "lookup_policy": {
          "const": "surrounding_max"
        },
        "height_mode": {
          "enum": [
            "uncorrected_screening",
            "corrected"
          ]
        },
        "mapping_overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "table_base",
              "reason"
            ],
            "properties": {
              "table_base": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "minLength": 5
              }
            },
            "additionalProperties": false
          }
        },
        "departure_category_overrides": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "domestic_jet",
              "international",
              "propeller_light"
            ]
          }
        }
      }
    }
  },
  "required": [
    "project",
    "revision",
    "data_mode",
    "crs",
    "receptors",
    "uncertainty_m"
  ],
  "additionalProperties": false
}
